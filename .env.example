# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings › API / API Keys). Na Vercel, cadastre as mesmas variáveis.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Endereço público do site (usado no link de confirmação de e-mail). Opcional em localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
